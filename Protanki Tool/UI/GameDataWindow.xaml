<Window x:Class="ProtankiTool.UI.GameDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Data" Height="600" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}"
        BorderThickness="1" BorderBrush="{DynamicResource Border}">

    <Window.Resources>

        <!-- ── Tab styling ─────────────────────────────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource WindowBackground}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Margin="0,0,3,0"
                                Padding="16,8">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{DynamicResource Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBackground}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TabBorder}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid styling ────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── ListBox styling ─────────────────────────────────────── -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorder}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{x:Null}"
                                Padding="8,5" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ScrollBar styling ───────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="{DynamicResource ScrollBarThumb}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox styling ────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="CbBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"/>
                                <Path Grid.Column="1"
                                      Data="M 0 0 L 5 5 L 10 0 Z"
                                      Fill="{DynamicResource Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Opacity="0.6"/>
                            </Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="{DynamicResource TextBoxBackground}"
                                        BorderBrush="{DynamicResource TextBoxBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CbBorder" Property="BorderBrush" Value="{DynamicResource Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Cbibd" Background="{TemplateBinding Background}" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Cbibd" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cbibd" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── RadioButton styling ─────────────────────────────────── -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- ── CheckBox styling ────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <TabControl>

            <!-- ══════════════ PAINTS TAB ══════════════ -->
            <TabItem Header="Paints">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add" Width="80" Margin="0,0,5,0" Click="AddPaintButton_Click"/>
                            <Button Content="Remove" Width="80" Click="RemovePaintButton_Click"/>
                        </StackPanel>
                        <ListBox x:Name="PaintsListBox" DisplayMemberPath="Name"
                                 SelectionChanged="PaintsListBox_SelectionChanged"/>
                    </DockPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Foreground}"/>
                            <TextBox x:Name="PaintNameTextBox" Height="28"
                                     Background="{DynamicResource TextBoxBackground}"
                                     Foreground="{DynamicResource TextBoxForeground}"
                                     BorderBrush="{DynamicResource TextBoxBorder}"
                                     LostFocus="PaintNameTextBox_LostFocus"/>
                        </StackPanel>

                        <GroupBox Grid.Row="1" Header="Protections (%)">
                            <DataGrid x:Name="ProtectionsDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="False" CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      CellEditEnding="ProtectionsDataGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Weapon" Binding="{Binding DamageTypeName}"
                                                        IsReadOnly="True" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                                <Setter Property="Padding" Value="6,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Protection %" Binding="{Binding Percentage}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                                <Setter Property="Padding" Value="6,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══════════════ TURRETS TAB ══════════════ -->
            <TabItem Header="Turrets">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,10"
                               Foreground="{DynamicResource Foreground}" Opacity="0.7" FontSize="12"
                               Text="Overview of all turrets, their range, and whether they can be used for defending."/>

                    <DataGrid Grid.Row="1" x:Name="TurretsDataGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Turret" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Damage Type" Binding="{Binding DamageType}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Can Defend" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Padding="6,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="No"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanDefend}" Value="True">
                                                            <Setter Property="Text" Value="Yes"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════ GAME PLAN TAB ══════════════ -->
            <TabItem Header="Game Plan">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Questions panel ── -->
                    <ScrollViewer Grid.Column="0" Margin="0,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <TextBlock Text="Map Size" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Foreground}"/>
                            <RadioButton x:Name="MapLargeRadio"  Content="Large"  IsChecked="True"/>
                            <RadioButton x:Name="MapMediumRadio" Content="Medium"/>
                            <RadioButton x:Name="MapSmallRadio"  Content="Small"/>

                            <TextBlock Text="Number of Players" FontWeight="SemiBold" Margin="0,16,0,8"
                                       Foreground="{DynamicResource Foreground}"/>
                            <ComboBox x:Name="PlayerCountComboBox"/>

                            <TextBlock Text="Defense" FontWeight="SemiBold" Margin="0,16,0,8"
                                       Foreground="{DynamicResource Foreground}"/>
                            <CheckBox x:Name="WantDefenseCheckBox" Content="Include defending roles"
                                      Checked="WantDefenseCheckBox_Changed" Unchecked="WantDefenseCheckBox_Changed"/>

                            <StackPanel x:Name="DefendingTurretPanel" Visibility="Collapsed">
                                <TextBlock Text="Defending Turret" FontWeight="SemiBold" Margin="0,16,0,8"
                                           Foreground="{DynamicResource Foreground}"/>
                                <ComboBox x:Name="DefendingTurretComboBox"/>
                            </StackPanel>

                            <TextBlock Text="Freeze or Fire" FontWeight="SemiBold" Margin="0,16,0,8"
                                       Foreground="{DynamicResource Foreground}"/>
                            <ComboBox x:Name="FreezeOrFireComboBox"/>

                            <Button Content="Generate Plan" Margin="0,20,0,0"
                                    Click="GeneratePlanButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Results panel ── -->
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="GamePlanPlaceholder"
                                   Text="Configure the options on the left and click 'Generate Plan'."
                                   Foreground="{DynamicResource Foreground}" Opacity="0.45"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>

                        <DataGrid x:Name="GamePlanDataGrid"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding PlayerNumber}" Width="36">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="72">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Turret" Binding="{Binding TurretName}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="76">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Recommended Paint" Binding="{Binding PaintName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
