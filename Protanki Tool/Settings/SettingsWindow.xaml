<Window x:Class="ProtankiTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ProtankiTool.Controls"
        Title="Settings" Height="720" Width="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        BorderThickness="1" BorderBrush="{DynamicResource Border}">

    <Window.Resources>

        <!-- ── Button styling ──────────────────────────────────────── -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ScrollBar styling ───────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="{DynamicResource ScrollBarThumb}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CheckBox styling ────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>

        <!-- ── RadioButton styling ─────────────────────────────────── -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Click Speed (ms)" Margin="0,0,10,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"/>
                <TextBox x:Name="ClickSpeedTextBox" Height="30" Margin="0,0,10,8"
                         Background="{DynamicResource TextBoxBackground}"
                         Foreground="{DynamicResource TextBoxForeground}"
                         BorderBrush="{DynamicResource TextBoxBorder}"/>

                <TextBlock Text="Game Process Name (e.g., ProTanki)" Margin="0,15,10,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}" ToolTip="The executable name of the game process without the .exe extension."/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="GameProcessNameTextBox" Height="30" Margin="0,0,10,0"
                             Background="{DynamicResource TextBoxBackground}"
                             Foreground="{DynamicResource TextBoxForeground}"
                             BorderBrush="{DynamicResource TextBoxBorder}"
                             IsReadOnly="True"/>
                    <Button Grid.Column="1" x:Name="UnlockGameProcessNameButton" Content="Unlock" Margin="0,0,10,0" Width="80"
                            Click="UnlockGameProcessNameButton_Click"/>
                </Grid>
                <TextBlock Text="Game Executable Path (Optional)" Margin="0,15,0,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="GamePathTextBox" Height="30" IsReadOnly="True" Margin="0,0,10,0"
                             Background="{DynamicResource TextBoxBackground}"
                             Foreground="{DynamicResource TextBoxForeground}"
                             BorderBrush="{DynamicResource TextBoxBorder}"/>
                    <Button Grid.Column="1" Content="Browse" Margin="0,0,10,0" Width="80"
                            Click="BrowseGamePathButton_Click"/>
                </Grid>
                <TextBlock Text="Clicker Coordinates" Margin="0,15,0,10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"/>

                <!-- Red Team Coordinates -->
                <Border Margin="0,0,0,8" Background="{DynamicResource TextBoxBackground}"
                        BorderBrush="{DynamicResource TextBoxBorder}" BorderThickness="1" CornerRadius="4">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Red Team" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/>
                        <TextBlock Grid.Column="1" Text="X:" VerticalAlignment="Center"
                                   Margin="0,0,6,0" Foreground="{DynamicResource Foreground}" Opacity="0.7"/>
                        <TextBox Grid.Column="2" x:Name="RedTeamXTextBox" Height="28"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource TextBoxForeground}"
                                 BorderBrush="{DynamicResource TextBoxBorder}"/>
                        <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center"
                                   Margin="10,0,6,0" Foreground="{DynamicResource Foreground}" Opacity="0.7"/>
                        <TextBox Grid.Column="4" x:Name="RedTeamYTextBox" Height="28"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource TextBoxForeground}"
                                 BorderBrush="{DynamicResource TextBoxBorder}"/>
                        <Button Grid.Column="6" x:Name="PickRedTeamButton" Content="Pick Coords"
                                Width="95" Height="28" Click="PickRedTeamButton_Click"/>
                    </Grid>
                </Border>

                <!-- Blue Team Coordinates -->
                <Border Margin="0,0,0,15" Background="{DynamicResource TextBoxBackground}"
                        BorderBrush="{DynamicResource TextBoxBorder}" BorderThickness="1" CornerRadius="4">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Blue Team" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/>
                        <TextBlock Grid.Column="1" Text="X:" VerticalAlignment="Center"
                                   Margin="0,0,6,0" Foreground="{DynamicResource Foreground}" Opacity="0.7"/>
                        <TextBox Grid.Column="2" x:Name="BlueTeamXTextBox" Height="28"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource TextBoxForeground}"
                                 BorderBrush="{DynamicResource TextBoxBorder}"/>
                        <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center"
                                   Margin="10,0,6,0" Foreground="{DynamicResource Foreground}" Opacity="0.7"/>
                        <TextBox Grid.Column="4" x:Name="BlueTeamYTextBox" Height="28"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource TextBoxForeground}"
                                 BorderBrush="{DynamicResource TextBoxBorder}"/>
                        <Button Grid.Column="6" x:Name="PickBlueTeamButton" Content="Pick Coords"
                                Width="95" Height="28" Click="PickBlueTeamButton_Click"/>
                    </Grid>
                </Border>


                <TextBlock Text="Hotkeys" Margin="0,15,0,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"/>

                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Global Toggle:" VerticalAlignment="Center" Margin="0,0,10,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <controls:HotKeyBox Grid.Row="0" Grid.Column="1" x:Name="GlobalHotKeyBox" Margin="0,0,10,8"
                                        Background="{DynamicResource TextBoxBackground}"
                                        Foreground="{DynamicResource TextBoxForeground}"
                                        BorderBrush="{DynamicResource TextBoxBorder}"/>


                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Red Team:" VerticalAlignment="Center" Margin="0,0,10,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <controls:HotKeyBox Grid.Row="1" Grid.Column="1" x:Name="RedTeamHotKeyBox" Margin="0,0,10,8"
                                        Background="{DynamicResource TextBoxBackground}"
                                        Foreground="{DynamicResource TextBoxForeground}"
                                        BorderBrush="{DynamicResource TextBoxBorder}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Blue Team:" VerticalAlignment="Center" Margin="0,0,10,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <controls:HotKeyBox Grid.Row="2" Grid.Column="1" x:Name="BlueTeamHotKeyBox" Margin="0,0,10,8"
                                        Background="{DynamicResource TextBoxBackground}"
                                        Foreground="{DynamicResource TextBoxForeground}"
                                        BorderBrush="{DynamicResource TextBoxBorder}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Gold Box Timer:" VerticalAlignment="Center" Margin="0,0,10,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <controls:HotKeyBox Grid.Row="3" Grid.Column="1" x:Name="GoldBoxTimerHotKeyBox" Margin="0,0,10,8"
                                        Background="{DynamicResource TextBoxBackground}"
                                        Foreground="{DynamicResource TextBoxForeground}"
                                        BorderBrush="{DynamicResource TextBoxBorder}"/>

                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="TransparentTimerWindowCheckBox" Content="Transparent Timer Window" Margin="0,0,10,8"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource Foreground}"/>
                </Grid>

                <TextBlock Text="Theme" Margin="0,15,0,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton x:Name="DarkRadio" Content="Dark" Margin="0,0,10,0"
                                 GroupName="Theme" Checked="ThemeRadio_Checked"
                                 Foreground="{DynamicResource Foreground}"/>
                    <RadioButton x:Name="LightRadio" Content="Light" GroupName="Theme"
                                 Checked="ThemeRadio_Checked"
                                 Foreground="{DynamicResource Foreground}"/>
                </StackPanel>

                <TextBlock Text="Updates" Margin="0,15,0,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                    <TextBlock x:Name="VersionTextBlock" Margin="0,0,0,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <TextBlock x:Name="LatestVersionTextBlock" Margin="0,0,0,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,0,0,8"
                               Foreground="{DynamicResource Foreground}"/>
                    <Button x:Name="CheckForUpdatesButton" Content="Check for Updates" Width="140"
                            Click="CheckForUpdatesButton_Click"/>
                    <Button x:Name="UpdateNowButton" Content="Update Now" Width="140" Margin="0,5,0,0"
                            Click="UpdateNowButton_Click"
                            Visibility="Collapsed"/>
                    <ProgressBar x:Name="DownloadProgressBar" Height="10" Margin="0,5,0,0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button x:Name="LogsButton" Content="View Logs" Width="80" Margin="0,0,10,0"
                    Click="LogsButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Width="80" IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>